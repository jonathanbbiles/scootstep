# deps
node_modules/
package-lock.json

# Capacitor native projects (regenerated at build time by `cap add ios` /
# `cap add android` in Codemagic). Nothing hand-edited in here survives, which is
# why every persistent native fact lives in scripts/patch-*.
ios/
android/

# Signing material — NEVER committed. The Android upload keystore lives outside the
# repo at ~/.config/android-keystores/ and reaches CI only as a secure Codemagic
# variable. Losing it means asking Google to reset the app's upload key.
*.jks
*.keystore
*.p12
*.p8
keystore.properties

# build + test artifacts
build/
shots/
*.log
.DS_Store

# dev-only harnesses that need extra deps (@napi-rs/canvas, jsdom) — kept out of the app bundle.
# engine-schema-test.mjs + validate-dances.mjs are dependency-free and ARE committed (for the
# "add a dance" workflow: node validate-dances.mjs).
render-catalog.mjs
smoke-test.mjs
gen-icon.mjs
